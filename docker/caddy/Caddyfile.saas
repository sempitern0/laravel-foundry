# Optional local SaaS subdomain TLS. TENANCY_MODE is documentation and
# local hostname testing only; Laravel must resolve and isolate tenants.
{$LOCAL_DOMAIN}, *.{$LOCAL_DOMAIN} {
    tls internal
    encode zstd gzip
    reverse_proxy web:80
    header X-Content-Type-Options nosniff
    header Referrer-Policy strict-origin-when-cross-origin
}
