# Infrastructure settings (generated/configured by make setup)
PROJECT_NAME=foundry
APP_LABEL="Laravel Foundry"
SETUP_CONFIGURED=0
COMPOSE_PROFILES=postgres,mailpit,dev
DB_ENGINE=postgres
DB_SERVER=postgres
DB_DATABASE=foundry
DB_USERNAME=foundry
DB_PASSWORD=local-only-change-me
DB_ROOT_PASSWORD=local-only-root-change-me
QUEUE_ENGINE=sync
MAIL_ENGINE=mailpit
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=hello@example.test
DB_UI=none
HTTP_PORT=8080
HTTPS_ENABLED=0
HTTPS_PORT=443
LOCAL_DOMAIN=foundry.test
VITE_PORT=5173
DB_UI_PORT=8081
MAILPIT_PORT=8025
DEV_UID=1000
DEV_GID=1000

# Optional SaaS architecture/testing blueprint; does not install tenant-aware code.
TENANCY_MODE=none
TENANCY_TEST_TENANTS=alpha,beta
TENANCY_TEST_PATH=/
# Optional response header (e.g. X-Tenant-Key) whose value must match the slug.
TENANCY_ASSERT_HEADER=
CADDY_LOCAL_CONFIG_FILE=./docker/caddy/Caddyfile.local
