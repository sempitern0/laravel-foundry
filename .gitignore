# Local configuration and secrets (Laravel source and lockfiles stay tracked)
.env
.env.*
!.env.example
/deploy/*.env
*.production.env
/certs/
/caddy-local-root.crt

# Dependencies, build output and runtime data
vendor/
node_modules/
/app/public/build/
/app/public/hot
/app/public/storage
/app/bootstrap/cache/*
!/app/bootstrap/cache/.gitignore
/app/storage/**
!/app/storage/**/
!/app/storage/**/.gitignore
/app/database/*.sqlite
/app/database/*.sqlite-*
/app/.phpunit.result.cache
/app/.phpunit.cache/
.phpunit.result.cache
.phpunit.cache/
coverage/
.nyc_output/
*.lcov
*.tsbuildinfo
.svelte-kit/
.vite/
.cache/
.parcel-cache/
dist/

# Foundry local state and backup archives (not project source)
/.foundry-starter
/.foundry-setup-pending
/.foundry-runtime-state
/.foundry-runtime-state.tmp
/app-backups/
/backups/

# Editor, OS and tool-specific temporary files
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.code-snippets
.history/
*.swp
*.swo
*~
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.npm/

# Host-specific generated Docker Compose configuration
/compose.override.yaml
/.foundry-host-override.*
/.foundry-host.json
